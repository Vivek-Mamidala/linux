# Terraform working directory
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Local variable files that may contain sensitive values
*.tfvars
*.tfvars.json

# Keep an example variables file if created
!terraform.tfvars.example

# Temporary files
*.tmp
*.bak
*.save
*.swp

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
